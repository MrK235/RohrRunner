{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RohrRunner",
  "version": "1.0.9",
  "identifier": "de.rohrrunner.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RohrRunner · Rohrnetz-Auslegung",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Lokale Rohrnetzplanung und technische Vorbemessung",
    "longDescription": "RohrRunner ist eine lokale Anwendung zur grafischen Erfassung und technischen Vorbemessung von Kältemittelrohrnetzen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFODE2NUUxMjM2NzZFQTkKUldTcGJtY2o0V1dCN2pZRkQ1ZFhqQmhkSFNKTUlWeER4TXNHb1ZSTFBkaXNnNS9UVGt4eURZS24K",
      "endpoints": [
        "https://github.com/MrK235/RohrRunner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
